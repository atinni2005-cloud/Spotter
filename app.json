{
  "expo": {
    "name": "Spotter",
    "slug": "spotter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotter.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spotter.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "spotter",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotter uses your photos to log meals and check your exercise form.",
          "cameraPermission": "Spotter uses the camera to photograph meals and film your sets for form feedback.",
          "microphonePermission": "Spotter records audio with your exercise videos."
        }
      ],
      "expo-notifications"
    ]
  }
}
