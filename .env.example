# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "API Keys").
# Both values are public and safe to ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Do NOT put your Anthropic API key here. It is set as a Supabase secret:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
